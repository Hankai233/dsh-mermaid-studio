{
  "name": "dsh-mermaid-studio",
  "version": "0.1.0",
  "description": "DSH 插件：对话里的 mermaid 围栏实时渲染成图，可缩放、全屏、导出 SVG，渲染结果本地缓存，切回来不重画。",
  "license": "GPL-3.0-or-later",
  "author": "Hanka",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/screenshots"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "devDependencies": {
    "mermaid": "11.17.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "mermaid",
    "diagram",
    "svg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hankai233/dsh-mermaid-studio.git"
  },
  "homepage": "https://github.com/Hankai233/dsh-mermaid-studio#readme",
  "bugs": {
    "url": "https://github.com/Hankai233/dsh-mermaid-studio/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
